/* Datos de TU red. Copia este archivo como "secrets.h" (en esta misma carpeta)
 * y cambia los tres valores. secrets.h NO se sube a git (ver .gitignore).
 *
 * - El ESP32-S3 solo se conecta a redes WiFi de 2.4 GHz.
 * - SERVER_IP es la IP, en esa misma red, del computador que corre web_server.py
 *   (la Raspberry Pi, o tu computador mientras pruebas).
 *   En macOS:  ipconfig getifaddr en0        En Linux/RPi:  hostname -I
 */
#pragma once

#define WIFI_SSID "TU_WIFI"
#define WIFI_PASS "TU_CLAVE"
#define SERVER_IP "192.168.1.100"
