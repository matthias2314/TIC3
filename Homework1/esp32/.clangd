CompileFlags:
    # GCC-only flags that clangd does not understand
    Remove: [-f*, -m*]
    # Compiler built-in headers (stddef.h, stdbool.h, stdarg.h...).
    # esp-clangd ships without its own copy, and --query-driver leaves this
    # GCC folder out on purpose, so we add it explicitly.
    Add:
      - -isystem
      - /Users/matthiasaliagafebres/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include
